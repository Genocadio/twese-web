# CavGo Gateway — the single entry point for all backend services.
# In production: https://api.gocavgo.com
# In local development: http://localhost:8080
NEXT_PUBLIC_API_URL=https://api.gocavgo.com

# Nexxauth — identity provider (login/register with email or phone + password).
# Base URL includes the platform slug: https://auth.nexxserve.dev/cavgo
NEXT_PUBLIC_NEXXAUTH_BASE_URL=https://auth.nexxserve.dev/cavgo

# WEB client key registered in the Nexxauth organisation (X-Client-Id header).
# Get this from the Nexxauth console → organisation → clients → WEB client.
NEXT_PUBLIC_NEXXAUTH_CLIENT_ID=
